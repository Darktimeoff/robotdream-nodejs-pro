# Навмисно "наївний" одностадійний образ — потрібен лише для порівняння розміру в README.
# У проді не використовується: тягне dev-залежності (typescript, @types/*) та вихідні .ts.
FROM node:24-alpine

WORKDIR /app

COPY . .

RUN npm install && npm run build

EXPOSE 3000

CMD ["node", "dist/index.js"]
